rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  Student Manager Pro — Firestore Security Rules (LOCKED)
//  • Password ab Firestore me hai hi nahi — sirf Firebase Auth me.
//  • Admin (email allowlist) poora data manage karta hai.
//  • Student Firebase Auth se login karta hai; wo SIRF apna doc
//    padh/apne self-service fields update kar sakta hai (authUid match).
//  • Anonymous (bina login) read/write = poori tarah DENY.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Sirf ye admin email poora data manage kar sakta hai.
    function isAllowedAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'smarttech@gmail.com'
        ];
    }

    // Signed-in student jiska auth uid is doc ke authUid se match karta hai.
    function isOwner() {
      return signedIn()
        && resource != null
        && resource.data.authUid == request.auth.uid;
    }

    // Student sirf ye self-service fields hi badal sakta hai —
    // username/fee/identity/authUid wagera kabhi nahi.
    function studentSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['attendance', 'totalPresent', 'totalAbsent', 'syllabus', 'reminderLog']);
    }

    match /students/{studentId} {
      allow read:   if isAllowedAdmin() || isOwner();
      allow create: if isAllowedAdmin();
      allow delete: if isAllowedAdmin();
      allow update: if isAllowedAdmin() || (isOwner() && studentSelfUpdate());
    }

    // Baaki poora database default-deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
